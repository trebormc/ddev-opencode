#!/usr/bin/env bash

#ddev-generated
## Description: Access the OpenCode AI container (TUI or shell)
## Usage: opencode [tui [title...]|shell|-opencode-option...|command...]
## Example: "ddev opencode" for TUI, "ddev opencode shell" for bash, "ddev opencode --continue" to pass options to opencode, "ddev opencode <command>" to run a command
## ExecRaw: true

OPENCODE_CONTAINER="ddev-${DDEV_SITENAME}-opencode"

# Allocate a TTY only when attached to a terminal, so the command also works
# in scripts, pipes and CI ("the input device is not a TTY" otherwise).
if [ -t 0 ] && [ -t 1 ]; then
    EXEC_FLAGS=(-it)
else
    EXEC_FLAGS=(-i)
fi

set_tab_title() {
    # Never write escape sequences into piped or captured output.
    [ -t 1 ] || return 0
    local custom_title="$1"
    if [ -n "$custom_title" ]; then
        printf '\033]0;%s - %s\007' "${DDEV_SITENAME}" "$custom_title"
    else
        printf '\033]0;%s - OpenCode\007' "${DDEV_SITENAME}"
    fi
}

restore_tab_title() {
    [ -t 1 ] || return 0
    printf '\033]0;%s\007' "${TERM_PROGRAM:-Terminal}"
}

case "$1" in
    ""|"tui")
        # --standalone: private server for this TUI (OpenCode 2 otherwise
        # shares one background service), so DDEV_TUI_TITLE and the usage
        # wrapper's telemetry env apply to this session only.
        if [ "$1" = "tui" ]; then
            shift
        fi
        CUSTOM_TITLE="$*"
        set_tab_title "$CUSTOM_TITLE"
        trap restore_tab_title EXIT
        docker exec "${EXEC_FLAGS[@]}" -u opencode \
            -e DDEV_TUI_TITLE="${CUSTOM_TITLE:-OpenCode}" \
            "$OPENCODE_CONTAINER" opencode --standalone
        ;;
    "shell"|"bash")
        set_tab_title "shell"
        trap restore_tab_title EXIT
        docker exec "${EXEC_FLAGS[@]}" -u opencode "$OPENCODE_CONTAINER" bash
        ;;
    -*)
        # An option instead of a command: it is meant for opencode. Options
        # go through untouched, --standalone included if the caller wants it.
        set_tab_title ""
        trap restore_tab_title EXIT
        docker exec "${EXEC_FLAGS[@]}" -u opencode \
            -e DDEV_TUI_TITLE="OpenCode" \
            "$OPENCODE_CONTAINER" opencode "$@"
        ;;
    *)
        set_tab_title "$1"
        trap restore_tab_title EXIT
        docker exec "${EXEC_FLAGS[@]}" -u opencode "$OPENCODE_CONTAINER" "$@"
        ;;
esac
